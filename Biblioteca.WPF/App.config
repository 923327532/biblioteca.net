<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <connectionStrings>
    <!-- La cadena de conexión vive en el App.config del proyecto de inicio (WPF)
         para que ConfigurationManager la encuentre en tiempo de ejecución. -->
    <add name="BibliotecaDB"
         connectionString="Server=.\SQLEXPRESS;Database=BibliotecaDB;Integrated Security=True;TrustServerCertificate=True;"
         providerName="Microsoft.Data.SqlClient" />
  </connectionStrings>
</configuration>
