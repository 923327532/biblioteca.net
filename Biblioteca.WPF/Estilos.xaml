<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:views="clr-namespace:Biblioteca.WPF.Views">

    <views:BoolAVisibilidadConverter x:Key="BoolAVisibilidad" />

    <SolidColorBrush x:Key="ColorFondo" Color="#F4F6F8" />
    <SolidColorBrush x:Key="ColorPanel" Color="#FFFFFF" />
    <SolidColorBrush x:Key="ColorPrimario" Color="#1F4E79" />
    <SolidColorBrush x:Key="ColorAcento" Color="#2E75B6" />
    <SolidColorBrush x:Key="ColorBorde" Color="#D0D7DE" />

    <Style TargetType="Button">
        <Setter Property="Padding" Value="14,8" />
        <Setter Property="Margin" Value="0,0,8,0" />
        <Setter Property="Background" Value="{StaticResource ColorAcento}" />
        <Setter Property="Foreground" Value="White" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Style.Triggers>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="0.45" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style TargetType="Label">
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="#333333" />
        <Setter Property="Padding" Value="0,6,0,2" />
    </Style>

    <Style TargetType="TextBox">
        <Setter Property="Padding" Value="6,5" />
        <Setter Property="Margin" Value="0,0,0,6" />
        <Setter Property="BorderBrush" Value="{StaticResource ColorBorde}" />
    </Style>

    <Style TargetType="ComboBox">
        <Setter Property="Padding" Value="6,5" />
        <Setter Property="Margin" Value="0,0,0,6" />
        <Setter Property="BorderBrush" Value="{StaticResource ColorBorde}" />
    </Style>

    <Style x:Key="Tarjeta" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource ColorPanel}" />
        <Setter Property="BorderBrush" Value="{StaticResource ColorBorde}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="6" />
        <Setter Property="Padding" Value="14" />
        <Setter Property="Margin" Value="0,0,0,12" />
    </Style>

    <Style x:Key="TituloModulo" TargetType="TextBlock">
        <Setter Property="FontSize" Value="20" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="Foreground" Value="{StaticResource ColorPrimario}" />
        <Setter Property="Margin" Value="0,0,0,10" />
    </Style>

    <Style TargetType="DataGrid">
        <Setter Property="AutoGenerateColumns" Value="False" />
        <Setter Property="IsReadOnly" Value="True" />
        <Setter Property="CanUserAddRows" Value="False" />
        <Setter Property="HeadersVisibility" Value="Column" />
        <Setter Property="GridLinesVisibility" Value="Horizontal" />
        <Setter Property="HorizontalGridLinesBrush" Value="{StaticResource ColorBorde}" />
        <Setter Property="AlternatingRowBackground" Value="#F7F9FB" />
        <Setter Property="BorderBrush" Value="{StaticResource ColorBorde}" />
    </Style>

</ResourceDictionary>
